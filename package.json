		"@types/d3-scale": "^4.0.9",
		"@types/node": "^26",
		"@types/nodemailer": "^8.0.1",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"@vitest/browser": "^4.1.9",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.6.0",
