# PostgreSQL connection (also used by compose.yaml to initialise the container)
POSTGRES_USER=cooking_diary
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cooking_diary
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
# Public URL of this instance; required in production for password reset links (ORIGIN is also accepted)
BETTER_AUTH_URL=http://localhost:5173
# Set to true to block new sign-ups
DISABLE_SIGNUP=false

# SMTP for password reset mails (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@example.com
