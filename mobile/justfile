# Cooking Diary Android app: build recipes. `just` shows the list, `just android` builds the
# debug app, installs it on the emulator (starting one if needed) and launches it.
#
# The debug build talks to the web server on the host at http://10.0.2.2:5173, so run
# `pnpm run db:start`, `pnpm db:seed` (demo@example.com / demo1234) and `pnpm dev` in the
# repository root first. The dev server must listen on 127.0.0.1 (see README).

set shell := ["bash", "-euo", "pipefail", "-c"]

app_id := "de.parndt.cooking_diary"

# The SDK location comes from ANDROID_HOME, falling back to the Android Studio default.
android_sdk := env("ANDROID_HOME", if os() == "macos" {
    home_directory() / "Library/Android/sdk"
} else {
    home_directory() / "Android/Sdk"
})
export ANDROID_HOME := android_sdk
adb := android_sdk / "platform-tools/adb"
emulator := android_sdk / "emulator/emulator"

# AVD that `just emulator` starts. Another one: `just avd=pixel android`.
avd := "default"

# The Kotlin Toolchain provisions its own JDK, but a local one is still handy for IDE tooling:
# Android Studio's JBR first, then JAVA_HOME. macOS ships a /usr/bin/java stub, so check for javac.
studio_jbr := if os() == "macos" {
    "/Applications/Android Studio.app/Contents/jbr/Contents/Home"
} else {
    "/opt/android-studio/jbr"
}
env_java := env("JAVA_HOME", "")
export JAVA_HOME := if path_exists(studio_jbr / "bin/javac") == "true" { studio_jbr } else if path_exists(env_java / "bin/javac") == "true" { env_java } else { "" }

kotlin := "./kotlin"
debug_apk := "build/tasks/_androidApp_buildAndroidDebug/gradle-project-debug.apk"
release_aab := "build/tasks/_androidApp_bundleAndroid/gradle-project-release.aab"
signing_properties := "androidApp/keystore.properties"

# List recipes
default:
    @just --list

# Start the Android emulator and wait until it has booted (skipped if a device is attached)
emulator name=avd:
    #!/usr/bin/env bash
    set -euo pipefail
    # With a device already attached a second emulator only gets in the way: adb and
    # `kotlin run` would have to pick one.
    if [ -n "$({{ adb }} devices | awk 'NR>1 && $2 == "device"')" ]; then
      echo "A device is already running."
      exit 0
    fi
    if ! {{ emulator }} -list-avds | grep -qx "{{ name }}"; then
      echo "AVD '{{ name }}' not found. Available:" >&2
      {{ emulator }} -list-avds >&2
      exit 1
    fi
    echo "Starting {{ name }} …"
    # Detached from the just process, otherwise the recipe hangs on the running emulator.
    nohup {{ emulator }} -avd "{{ name }}" >/dev/null 2>&1 &
    {{ adb }} wait-for-device
    # wait-for-device only reports the connection; installing works once the boot has
    # finished, so wait for sys.boot_completed as well.
    until [ "$({{ adb }} shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = "1" ]; do
      sleep 2
    done
    echo "{{ name }} is ready."

# Build the debug app, install it on the emulator (starting it if needed) and relaunch it
android: emulator
    #!/usr/bin/env bash
    set -euo pipefail
    device=$({{ adb }} devices | awk 'NR>1 && $2 == "device" { print $1; exit }')
    {{ adb }} -s "${device}" shell am force-stop {{ app_id }}
    # `kotlin run` builds, installs and starts the activity, then returns.
    {{ kotlin }} run -m androidApp -d "${device}"
    echo "Running on ${device}."

# Build the debug APK without installing it
build:
    {{ kotlin }} build -m androidApp
    @echo "APK: mobile/{{ debug_apk }}"

# Build the signed release bundle (.aab) for the Play Console
release:
    #!/usr/bin/env bash
    set -euo pipefail
    # Without keystore.properties the toolchain only warns and emits an unsigned bundle,
    # which Play rejects, so refuse to build instead.
    if [ ! -f "{{ signing_properties }}" ]; then
      echo "{{ signing_properties }} is missing: copy androidApp/keystore.properties.example" >&2
      echo "and point it at your upload key (see README)." >&2
      exit 1
    fi
    store_file=$(sed -n 's/^storeFile=//p' "{{ signing_properties }}")
    if [ ! -f "${store_file}" ]; then
      echo "storeFile '${store_file}' from {{ signing_properties }} does not exist." >&2
      exit 1
    fi
    {{ kotlin }} package -m androidApp -v release -f aab
    version_name=$(sed -n 's/^ *versionName: *//p' androidApp/module.yaml)
    version_code=$(sed -n 's/^ *versionCode: *//p' androidApp/module.yaml)
    out="build/release/cooking-diary-${version_name}-${version_code}.aab"
    mkdir -p build/release
    cp "{{ release_aab }}" "${out}"
    jarsigner -verify "${out}" >/dev/null
    echo "Signed bundle: mobile/${out}"
    echo "Upload it in the Play Console. Bump versionCode in androidApp/module.yaml before the next upload."

# Run the shared unit tests on the host JVM (no emulator needed)
test:
    {{ kotlin }} test -m shared -p android

# Follow the app's log output (the app must be running)
logcat:
    #!/usr/bin/env bash
    set -euo pipefail
    pid=$({{ adb }} shell pidof -s {{ app_id }} | tr -d '\r' || true)
    if [ -z "${pid}" ]; then
      echo "{{ app_id }} is not running. Start it with \`just android\`." >&2
      exit 1
    fi
    {{ adb }} logcat --pid="${pid}"

# Remove build outputs
clean:
    {{ kotlin }} clean

# Show what just resolves on this machine: SDK, JDK, AVDs
doctor:
    #!/usr/bin/env bash
    set -uo pipefail
    echo "ANDROID_HOME : [{{ android_sdk }}]"
    echo "  adb        : $(test -x "{{ adb }}" && echo yes || echo NO)"
    echo "  emulator   : $(test -x "{{ emulator }}" && echo yes || echo NO)"
    echo "JAVA_HOME    : [{{ JAVA_HOME }}] (optional, the Kotlin Toolchain brings its own JDK)"
    echo "  javac      : $(test -x "{{ JAVA_HOME }}/bin/javac" && echo yes || echo NO)"
    echo "kotlin       : $(test -x "{{ kotlin }}" && echo yes || echo NO)"
    echo "avd          : {{ avd }}"
    echo "signing      : $(test -f "{{ signing_properties }}" && echo "{{ signing_properties }} found" || echo "no {{ signing_properties }} (needed for \`just release\`)")"
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 http://127.0.0.1:5173/login || true)
    echo "dev server   : $([ "${code}" = "200" ] && echo "reachable on 127.0.0.1:5173" || echo "NOT reachable on 127.0.0.1:5173 (emulator uses 10.0.2.2 → 127.0.0.1)")"
    echo "--- AVDs ---"
    {{ emulator }} -list-avds
    echo "--- devices ---"
    {{ adb }} devices
